# Shohoj Aviation Academy Certificate Verification System
# Environment Configuration

# Public app verification URL (defaults to window.location.origin if unset)
VITE_APP_URL="https://verify.shohojaviation.com"

# Supabase PostgreSQL & Storage Configuration (Free Tier)
# Found in your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Service role key (Used ONLY in server-side edge functions or database setup, NEVER exposed to browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Initial Admin Credentials Configuration (configured during first setup)
ADMIN_INITIAL_ID="Hriidoo"
ADMIN_INITIAL_PASSWORD="your-strong-configured-password"

